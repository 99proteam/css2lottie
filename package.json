{
  "name": "css2lottie",
  "version": "0.1.0",
  "description": "Convert HTML + CSS animations (@keyframes, transitions) and inline SVG into Lottie JSON. CSS to Lottie converter, no After Effects required.",
  "keywords": [
    "lottie",
    "css-to-lottie",
    "html-to-lottie",
    "svg-to-lottie",
    "lottie-converter",
    "lottie-generator",
    "lottie-json",
    "bodymovin",
    "css",
    "css-animation",
    "animation",
    "keyframes",
    "transitions",
    "svg",
    "svg-animation",
    "web-animations",
    "converter",
    "after-effects",
    "after-effects-alternative",
    "lottie-web",
    "lottiefiles",
    "motion-design",
    "cli",
    "playwright"
  ],
  "homepage": "https://99proteam.github.io/css2lottie/",
  "bugs": {
    "url": "https://github.com/99proteam/css2lottie/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99proteam/css2lottie.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/99proteam"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "css2lottie": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "examples": "node scripts/build-examples.mjs",
    "prepublishOnly": "npm run build",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs --serve"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lottie-animation-community/lottie-specs": "^0.3.2",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "sideEffects": false
}
